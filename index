<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Python Practice — All Sessions</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@400;500;600&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"></script>
<script src="https://cdn.jsdelivr.net/pyodide/v0.25.0/full/pyodide.js"></script>
<style>
:root {
  --bg:       #f5f2eb;
  --card:     #ffffff;
  --navy:     #1b2a4a;
  --teal:     #2a7f6f;
  --teal-lt:  #e8f5f2;
  --amber:    #e07b39;
  --pass:     #1f7a55;
  --pass-bg:  #edf7f2;
  --fail:     #c0392b;
  --fail-bg:  #fdf0ef;
  --code-bg:  #282a36;
  --border:   #e0dbd0;
  --text:     #1b2a4a;
  --muted:    #7a7a8a;
  --mono:     'Fira Code', monospace;
  --sans:     'DM Sans', sans-serif;
  --serif:    'Fraunces', serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--sans); background: var(--bg); color: var(--text); min-height: 100vh; }

/* ── Loading ───────────────────────────────────────────── */
#loading {
  position: fixed; inset: 0; background: var(--navy);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  z-index: 999; gap: 20px; transition: opacity .5s;
}
#loading h2 { font-family: var(--serif); color: #fff; font-size: 1.6rem; font-weight: 400; }
#loading p  { color: #8899bb; font-size: .9rem; }
.spinner {
  width: 44px; height: 44px; border: 3px solid #2a3f6a;
  border-top-color: var(--amber); border-radius: 50%;
  animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ── Header ────────────────────────────────────────────── */
header {
  background: var(--navy); color: #fff;
  position: sticky; top: 0; z-index: 10;
  box-shadow: 0 2px 16px rgba(0,0,0,.2);
}
.header-inner {
  padding: 20px 40px 14px;
  display: flex; flex-direction: column; gap: 10px;
}
.header-top {
  display: flex; align-items: flex-start;
  justify-content: space-between; gap: 12px;
}
.course-label {
  font-size: .68rem; color: rgba(255,255,255,.4);
  text-transform: uppercase; letter-spacing: .1em;
  font-family: var(--mono); margin-bottom: 3px;
}
header h1 {
  font-family: var(--serif); font-size: 1.25rem; font-weight: 600;
  letter-spacing: -.01em; line-height: 1.2;
}
header h1 span { color: var(--amber); }
.badge {
  font-size: .72rem; background: rgba(255,255,255,.1);
  padding: 4px 11px; border-radius: 20px; font-family: var(--mono);
  white-space: nowrap; flex-shrink: 0; margin-top: 2px;
}
.progress-row { display: flex; align-items: center; gap: 12px; }
.progress-bar {
  flex: 1; height: 5px; background: rgba(255,255,255,.12);
  border-radius: 10px; overflow: hidden;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, var(--teal), #4ecca3);
  border-radius: 10px; transition: width .5s cubic-bezier(.4,0,.2,1); width: 0%;
}
.progress-label {
  font-size: .78rem; color: #8899bb; white-space: nowrap;
  font-variant-numeric: tabular-nums; min-width: 48px; text-align: right;
}

/* ── Tab bar ───────────────────────────────────────────── */
.tab-bar {
  display: flex; border-top: 1px solid rgba(255,255,255,.07);
  overflow-x: auto; scrollbar-width: none; -ms-overflow-style: none; padding: 0 28px;
}
.tab-bar::-webkit-scrollbar { display: none; }
.tab-btn {
  flex-shrink: 0; padding: 9px 14px;
  border: none; border-bottom: 3px solid transparent;
  background: transparent; color: rgba(255,255,255,.45);
  font-family: var(--sans); font-size: .82rem; font-weight: 600;
  cursor: pointer; white-space: nowrap; transition: color .15s, border-color .15s, background .15s;
}
.tab-btn:hover { color: rgba(255,255,255,.85); background: rgba(255,255,255,.05); }
.tab-btn.active { color: #fff; border-bottom-color: var(--amber); }
.tab-btn.done::after { content: ' ✓'; color: #4ecca3; font-size: .78rem; }

/* ── Session panels ────────────────────────────────────── */
.session-panel {
  max-width: 860px; margin: 0 auto;
  padding: 36px 24px 80px;
  display: flex; flex-direction: column; gap: 28px; width: 100%;
}

/* ── Question cards ────────────────────────────────────── */
.card {
  background: var(--card); border-radius: 14px;
  box-shadow: 0 2px 12px rgba(0,0,0,.07);
  border: 1px solid var(--border); overflow: hidden;
  animation: fadeUp .4s ease both;
}
@keyframes fadeUp {
  from { opacity:0; transform: translateY(12px); }
  to   { opacity:1; transform: translateY(0); }
}
.card.challenge { border-color: var(--amber); }

.card-header {
  display: flex; align-items: center; gap: 14px;
  padding: 18px 24px; border-bottom: 1px solid var(--border); background: #fdfcfa;
}
.qnum {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--navy); color: #fff;
  font-family: var(--mono); font-size: .8rem; font-weight: 500;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.card.challenge .qnum { background: var(--amber); }
.card-header h2 { font-family: var(--serif); font-size: 1.05rem; font-weight: 600; flex: 1; }
.status-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: #d8d5ce; transition: background .3s;
}
.status-dot.pass { background: var(--pass); }
.status-dot.fail { background: var(--fail); }

.card-body { padding: 20px 24px; }
.instructions {
  font-size: .93rem; line-height: 1.7; color: #3a3a4a; margin-bottom: 16px;
}
.instructions code {
  font-family: var(--mono); font-size: .85rem;
  background: #f0ede6; padding: 1px 6px; border-radius: 4px; color: var(--teal);
}
.instructions strong { color: var(--navy); }
.instructions em { color: #555; }

.expected-box {
  background: var(--code-bg); border-radius: 8px;
  padding: 12px 16px; margin-bottom: 16px;
  font-family: var(--mono); font-size: .82rem; color: #f8f8f2; line-height: 1.6;
}
.expected-box .label {
  color: #6272a4; font-size: .72rem;
  text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px;
}

.tip-box {
  background: var(--teal-lt); border-left: 3px solid var(--teal);
  border-radius: 0 8px 8px 0; padding: 10px 14px; margin-bottom: 16px;
  font-size: .86rem; color: #1a4a40; line-height: 1.6;
}
.tip-box code {
  font-family: var(--mono); font-size: .82rem;
  background: rgba(42,127,111,.15); padding: 1px 5px; border-radius: 3px;
}

/* ── CodeMirror ────────────────────────────────────────── */
.CodeMirror {
  border-radius: 8px; font-family: var(--mono) !important;
  font-size: 13.5px !important; line-height: 1.65 !important;
  height: auto; min-height: 80px;
}
.CodeMirror-scroll { min-height: 80px; }

/* ── Buttons ───────────────────────────────────────────── */
.btn-row { display: flex; gap: 10px; margin-top: 12px; }
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 18px; border-radius: 8px; border: none;
  font-family: var(--sans); font-size: .85rem; font-weight: 600;
  cursor: pointer; transition: all .15s;
}
.btn-run   { background: var(--navy); color: #fff; }
.btn-run:hover   { background: #263a60; }
.btn-check { background: var(--teal); color: #fff; }
.btn-check:hover { background: #236958; }
.btn-reset {
  background: transparent; color: var(--muted);
  border: 1px solid var(--border); margin-left: auto;
}
.btn-reset:hover { color: var(--text); border-color: #aaa; }

/* ── Output ────────────────────────────────────────────── */
.output-panel {
  margin-top: 14px; background: var(--code-bg);
  border-radius: 8px; overflow: hidden; display: none;
}
.output-panel.visible { display: block; }
.output-label {
  padding: 6px 14px; font-family: var(--mono); font-size: .7rem;
  color: #6272a4; text-transform: uppercase; letter-spacing: .06em;
  border-bottom: 1px solid rgba(255,255,255,.05);
  display: flex; justify-content: space-between; align-items: center;
}
.output-text {
  padding: 12px 16px; font-family: var(--mono); font-size: .84rem;
  color: #f8f8f2; white-space: pre-wrap; line-height: 1.65; min-height: 36px;
}
.output-text.error { color: #ff5555; }

/* ── Result ────────────────────────────────────────────── */
.result-panel {
  margin-top: 10px; border-radius: 8px; padding: 12px 16px;
  display: none; font-size: .88rem; line-height: 1.6;
}
.result-panel.visible { display: block; }
.result-panel.pass { background: var(--pass-bg); border: 1px solid #b7e4cc; color: var(--pass); }
.result-panel.fail { background: var(--fail-bg); border: 1px solid #f5c0bb; color: var(--fail); }
.result-title { font-weight: 600; font-size: .95rem; margin-bottom: 4px; }
.diff-row { font-family: var(--mono); font-size: .8rem; margin-top: 6px; }
.diff-row span { display: inline-block; padding: 1px 6px; border-radius: 3px; margin: 1px 0; }
.diff-got      { background: #fce8e6; color: #c0392b; }
.diff-expected { background: #e6f4ea; color: #1f7a55; }

/* ── Responsive ────────────────────────────────────────── */
@media (max-width: 540px) {
  .header-inner { padding: 14px 16px 10px; }
  .tab-bar { padding: 0 6px; }
  .tab-btn { padding: 8px 10px; font-size: .75rem; }
  .session-panel { padding: 24px 12px 60px; }
  .card-header { padding: 14px 16px; }
  .card-body { padding: 16px 16px; }
  header h1 { font-size: 1.05rem; }
}
</style>
</head>
<body>

<!-- Loading -->
<div id="loading">
  <div class="spinner"></div>
  <h2>Setting up Python…</h2>
  <p>Loading Pyodide runtime — just a moment</p>
</div>

<!-- Header -->
<header>
  <div class="header-inner">
    <div class="header-top">
      <div>
        <div class="course-label">Python Practice</div>
        <h1>Session <span id="session-num">1</span> — <span id="session-sub">Hello, Python</span></h1>
      </div>
      <span class="badge" id="session-badge">7 questions</span>
    </div>
    <div class="progress-row">
      <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
      <div class="progress-label" id="progressLabel">0 / 7</div>
    </div>
  </div>
  <div class="tab-bar">
    <button class="tab-btn active" id="tab-btn-0" onclick="switchTab(0)">Session 1</button>
    <button class="tab-btn"        id="tab-btn-1" onclick="switchTab(1)">Session 2</button>
    <button class="tab-btn"        id="tab-btn-2" onclick="switchTab(2)">Session 3</button>
    <button class="tab-btn"        id="tab-btn-3" onclick="switchTab(3)">Session 4</button>
    <button class="tab-btn"        id="tab-btn-4" onclick="switchTab(4)">Session 5</button>
    <button class="tab-btn"        id="tab-btn-5" onclick="switchTab(5)">Session 6</button>
    <button class="tab-btn"        id="tab-btn-6" onclick="switchTab(6)">Session 7</button>
    <button class="tab-btn"        id="tab-btn-7" onclick="switchTab(7)">Session 8</button>
    <button class="tab-btn"        id="tab-btn-8" onclick="switchTab(8)">Session 9</button>
    <button class="tab-btn"        id="tab-btn-9" onclick="switchTab(9)">Session 10</button>
  </div>
</header>

<main id="main"></main>

<script>
// ── Session & question definitions ───────────────────────────────────────────
const SESSIONS = [

  /* ════════════════════════════════════════════════════════
     Session 1 — Hello, Python
  ════════════════════════════════════════════════════════ */
  {
    num: 1, title: "Hello, Python",
    questions: [
      {
        id: 1, title: "Hello, World!",
        instructions: `Use <code>print()</code> to display exactly the text below.`,
        tip: null,
        expected: ["Hello, World!"],
        starter: `# Write your print() statement below\n`,
        check(lines) {
          if (lines[0] === "Hello, World!") return ok();
          return fail([{ got: lines[0] ?? "(nothing)", exp: "Hello, World!" }]);
        }
      },
      {
        id: 2, title: "Personalised Greeting",
        instructions: `Store your name in a variable called <code>name</code>, then print a greeting.\n\nThe output should look like: <code>Hello, Alice!</code> (using your own name)`,
        tip: null,
        expected: ["Hello, <your name>!"],
        starter: `name = "Alice"   # ← change to your name\n\n# Print: Hello, <name>!\n`,
        check(lines) {
          const l = lines[0] ?? "";
          if (l.startsWith("Hello, ") && l.endsWith("!") && l.length > 8) return ok("Looks great!");
          return fail([{ got: l, exp: 'Hello, <your name>!  (must start with "Hello, " and end with "!")' }]);
        }
      },
      {
        id: 3, title: "Two-line Introduction",
        instructions: `Use <strong>two</strong> <code>print()</code> calls to produce two lines.\n\nLine 1: <code>My name is Jake.</code>\nLine 2: <code>I am 20 years old.</code>\n\n(You can change the name and age — the format is what matters!)`,
        tip: null,
        expected: ["My name is <name>.", "I am <age> years old."],
        starter: `name = "Jake"\nage  = 20\n\n# Write two print() statements\n`,
        check(lines) {
          const diffs = [];
          const l1 = lines[0] ?? "", l2 = lines[1] ?? "";
          if (!l1.startsWith("My name is ") || !l1.endsWith("."))
            diffs.push({ got: l1, exp: 'My name is <name>.  (must start with "My name is " and end with ".")' });
          if (!l2.startsWith("I am ") || !l2.endsWith(" years old."))
            diffs.push({ got: l2, exp: "I am <age> years old." });
          if (lines.length < 2 && diffs.length === 0)
            diffs.push({ got: "(only 1 line)", exp: "Need 2 lines" });
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 4, title: "Sum of Two Numbers",
        instructions: `<code>a = 15</code> and <code>b = 27</code> are given.\n\nCalculate their sum and print it in this exact format:`,
        tip: null,
        expected: ["15 + 27 = 42"],
        starter: `a = 15\nb = 27\n\n# Print: 15 + 27 = 42\n`,
        check(lines) {
          if (lines[0] === "15 + 27 = 42") return ok();
          return fail([{ got: lines[0] ?? "(nothing)", exp: "15 + 27 = 42" }]);
        }
      },
      {
        id: 5, title: "Rectangle Info",
        instructions: `<code>width = 6</code> and <code>height = 9</code> are given.\n\nPrint <strong>two lines</strong> — area first, then perimeter:\n\n<strong>Formula:</strong> area = width × height,  perimeter = 2 × (width + height)`,
        tip: null,
        expected: ["Area: 54", "Perimeter: 30"],
        starter: `width  = 6\nheight = 9\n\n# Print two lines: Area and Perimeter\n`,
        check(lines) {
          const diffs = [];
          if (lines[0] !== "Area: 54")      diffs.push({ got: lines[0] ?? "(nothing)", exp: "Area: 54" });
          if (lines[1] !== "Perimeter: 30") diffs.push({ got: lines[1] ?? "(nothing)", exp: "Perimeter: 30" });
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 6, title: "Swap Two Variables",
        instructions: `<code>x = 10</code> and <code>y = 25</code> are given.\n\nSwap their values, then print both on separate lines.\n\n<em>Hint: try <code>x, y = y, x</code></em>`,
        tip: null,
        expected: ["x = 25", "y = 10"],
        starter: `x = 10\ny = 25\n\n# Swap x and y, then print both\n`,
        check(lines) {
          const diffs = [];
          if (lines[0] !== "x = 25") diffs.push({ got: lines[0] ?? "(nothing)", exp: "x = 25" });
          if (lines[1] !== "y = 10") diffs.push({ got: lines[1] ?? "(nothing)", exp: "y = 10" });
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: "C", isChallenge: true, title: "⭐ Challenge — Shopping Receipt",
        instructions: `The three items below are given. Print a 3-line receipt where each line follows this format: <code>Item: $price</code>`,
        tip: null,
        expected: ["Apple: $1.5", "Bread: $2.99", "Milk: $3.0"],
        starter: `item1, price1 = "Apple", 1.5\nitem2, price2 = "Bread", 2.99\nitem3, price3 = "Milk",  3.0\n\n# Print three lines\n`,
        check(lines) {
          const exp = ["Apple: $1.5", "Bread: $2.99", "Milk: $3.0"];
          const diffs = exp.map((e,i) => lines[i] !== e ? { got: lines[i] ?? "(nothing)", exp: e } : null).filter(Boolean);
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      }
    ]
  },

  /* ════════════════════════════════════════════════════════
     Session 2 — Data Types & Numbers
  ════════════════════════════════════════════════════════ */
  {
    num: 2, title: "Data Types & Numbers",
    questions: [
      {
        id: 1, title: "What Type Is It?",
        instructions: `Python has four basic data types you'll use constantly: <code>int</code>, <code>float</code>, <code>str</code>, and <code>bool</code>.\n\nUse <code>print(type(...))</code> on each of the four values below — one <code>print()</code> per line.`,
        tip: `<code>type(42)</code> returns <code>&lt;class 'int'&gt;</code> — just pass it straight into <code>print()</code>!`,
        expected: ["<class 'int'>", "<class 'float'>", "<class 'str'>", "<class 'bool'>"],
        starter: `# Print the type of each value below\nprint(type(42))\n# now do: 3.14  "hello"  True\n`,
        check(lines) {
          const exp = ["<class 'int'>", "<class 'float'>", "<class 'str'>", "<class 'bool'>"];
          const diffs = exp.map((e,i) => lines[i] !== e ? { got: lines[i] ?? "(missing)", exp: e } : null).filter(Boolean);
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 2, title: "Integer Arithmetic",
        instructions: `<code>a = 17</code> and <code>b = 5</code> are given.\n\nPrint the result of <strong>three operations</strong>, each on its own line:\n<code>a + b</code> &nbsp; <code>a - b</code> &nbsp; <code>a * b</code>`,
        tip: null,
        expected: ["22", "12", "85"],
        starter: `a = 17\nb = 5\n\n# Print a+b, a-b, and a*b on separate lines\n`,
        check(lines) {
          const exp = ["22", "12", "85"];
          const diffs = exp.map((e,i) => lines[i] !== e ? { got: lines[i] ?? "(missing)", exp: e } : null).filter(Boolean);
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 3, title: "Three Kinds of Division",
        instructions: `Python has three division operators:\n<code>a / b</code> → regular division (float)\n<code>a // b</code> → floor division (drops decimal)\n<code>a % b</code> → modulo (remainder only)\n\n<code>a = 17</code>, <code>b = 5</code>. Print each result on its own line.`,
        tip: `<code>//</code> keeps only the whole part. <code>%</code> keeps only the remainder.`,
        expected: ["3.4", "3", "2"],
        starter: `a = 17\nb = 5\n\n# Print: a/b, a//b, a%b\n`,
        check(lines) {
          const exp = ["3.4", "3", "2"];
          const diffs = exp.map((e,i) => lines[i] !== e ? { got: lines[i] ?? "(missing)", exp: e } : null).filter(Boolean);
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 4, title: "Casting: String → Int",
        instructions: `<code>age_str = "23"</code> is a <strong>string</strong>, not a number — you can't do math with it yet!\n\nCast it to an integer using <code>int()</code>, add <code>7</code> to it, then print the result.`,
        tip: `<code>int("23")</code> turns the string <code>"23"</code> into the number <code>23</code>.`,
        expected: ["30"],
        starter: `age_str = "23"\n\n# Cast to int, add 7, then print\n`,
        check(lines) {
          if (lines[0] === "30") return ok();
          return fail([{ got: lines[0] ?? "(nothing)", exp: "30" }]);
        }
      },
      {
        id: 5, title: "Casting: Float ↔ Int",
        instructions: `Two values are given. Print two lines:\n\nLine 1: cast <code>price = 9.99</code> to <code>int</code> and print it\nLine 2: cast <code>score = 87</code> to <code>float</code> and print it\n\nNotice what happens to the decimal!`,
        tip: `<code>int(9.99)</code> does <strong>not</strong> round — it simply drops everything after the decimal point.`,
        expected: ["9", "87.0"],
        starter: `price = 9.99\nscore = 87\n\n# Line 1: print int(price)\n# Line 2: print float(score)\n`,
        check(lines) {
          const diffs = [];
          if (lines[0] !== "9")    diffs.push({ got: lines[0] ?? "(missing)", exp: "9" });
          if (lines[1] !== "87.0") diffs.push({ got: lines[1] ?? "(missing)", exp: "87.0" });
          return diffs.length === 0 ? ok() : fail(diffs);
        }
      },
      {
        id: 6, title: "Boolean Results",
        instructions: `Comparisons in Python return <code>True</code> or <code>False</code>.\n\n<code>x = 10</code>, <code>y = 3</code>. Print the result of these three comparisons on separate lines:\n<code>x &gt; y</code> &nbsp; <code>x == y</code> &nbsp; <code>x != y</code>`,
        tip: `<code>==</code> checks equality. <code>!=</code> means "not equal". Python capitalises <code>True</code> and <code>False</code>.`,
        expected: ["True", "False", "True"],
        starter: `x = 10\ny = 3\n\n# Print x > y, x == y, x != y\n`,
        check(lines) {
          const exp = ["True", "False", "True"];
          const diffs = exp.map((e,i) => lines[i] !== e ? { got: lines[i] ?? "(missing)", exp: e } : null).filter(Boolean);
          return diffs.length === 0 ? ok() : fail(diffs);
