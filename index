// ── Helpers ──────────────────────────────────────────────────────────────────
function ok(msg = "All lines match!") { return { pass: true, msg }; }
function fail(diffs) { return { pass: false, diffs }; }
function escHtml(s) {
  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

// ── State ────────────────────────────────────────────────────────────────────
let pyodide = null;
const editors = {};
const passed  = Array.from({ length: 10 }, () => new Set());
let currentTab = 0;
const editorReady = Array(10).fill(false);

// ── Build HTML structure (all sessions, no CodeMirror yet) ───────────────────
function buildUI() {
  const main = document.getElementById('main');
  SESSIONS.forEach((session, sidx) => {
    const panel = document.createElement('div');
    panel.className = 'session-panel';
    panel.id = `panel-${sidx}`;
    panel.style.display = sidx === 0 ? 'flex' : 'none';

    session.questions.forEach((q, idx) => {
      const ekey = `s${sidx}-${q.id}`;
      const expHtml = q.expected.map(l => `<div>${escHtml(l)}</div>`).join('');
      const tipHtml = q.tip ? `<div class="tip-box">💡 ${q.tip}</div>` : '';
      const card = document.createElement('div');
      card.className = 'card' + (q.isChallenge ? ' challenge' : '');
      card.id = `card-${ekey}`;
      card.innerHTML = `
        <div class="card-header">
          <div class="qnum">${q.id}</div>
          <h2>${q.title}</h2>
          <div class="status-dot" id="dot-${ekey}"></div>
        </div>
        <div class="card-body">
          <p class="instructions">${q.instructions.replace(/\n/g,'<br>')}</p>
          ${tipHtml}
          <div class="expected-box">
            <div class="label">Expected output</div>
            <div id="exp-${ekey}">${expHtml}</div>
          </div>
          <textarea id="editor-${ekey}">${q.starter}</textarea>
          <div class="btn-row">
            <button class="btn btn-run"   onclick="runCode(${sidx},'${q.id}')">▶  Run</button>
            <button class="btn btn-check" onclick="checkCode(${sidx},'${q.id}')">✓  Check</button>
            <button class="btn btn-reset" onclick="resetCode(${sidx},'${q.id}')">Reset</button>
          </div>
          <div class="output-panel" id="out-${ekey}">
            <div class="output-label">
              <span>Output</span>
              <span id="out-time-${ekey}" style="color:#44475a"></span>
            </div>
            <div class="output-text" id="out-text-${ekey}"></div>
          </div>
          <div class="result-panel" id="res-${ekey}"></div>
        </div>`;
      panel.appendChild(card);
    });
    main.appendChild(panel);
  });
}

// ── Lazy CodeMirror init ─────────────────────────────────────────────────────
function initEditors(sidx) {
  if (editorReady[sidx]) return;
  editorReady[sidx] = true;
  SESSIONS[sidx].questions.forEach(q => {
    const ekey = `s${sidx}-${q.id}`;
    const ta = document.getElementById(`editor-${ekey}`);
    if (ta) {
      editors[ekey] = CodeMirror.fromTextArea(ta, {
        mode: 'python', theme: 'dracula', lineNumbers: true,
        indentUnit: 4, tabSize: 4, indentWithTabs: false,
        extraKeys: { Tab: cm => cm.execCommand('indentMore') }
      });
    }
  });
}

// ── Tab switching ────────────────────────────────────────────────────────────
function switchTab(sidx) {
  document.querySelectorAll('.tab-btn').forEach((btn, i) =>
    btn.classList.toggle('active', i === sidx));
  document.querySelectorAll('.session-panel').forEach((panel, i) =>
    panel.style.display = i === sidx ? 'flex' : 'none');
  currentTab = sidx;
  const s = SESSIONS[sidx];
  document.getElementById('session-num').textContent = s.num;
  document.getElementById('session-sub').textContent = s.title;
  document.getElementById('session-badge').textContent = `${s.questions.length} questions`;
  updateProgress(sidx);
  initEditors(sidx);
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// ── Pyodide execution ────────────────────────────────────────────────────────
async function runPython(code) {
  const result = await pyodide.runPythonAsync(`
import sys, io, traceback
_buf = io.StringIO()
_err = None
try:
    sys.stdout = _buf
    exec(${JSON.stringify(code)})
except Exception as e:
    _err = traceback.format_exc()
finally:
    sys.stdout = sys.__stdout__
(_buf.getvalue(), _err)
`);
  const [output, err] = result.toJs();
  return { output: output || '', error: err || null };
}

// ── Run ──────────────────────────────────────────────────────────────────────
async function runCode(sidx, qid) {
  if (!pyodide) return alert('Python is still loading — please wait.');
  const ekey = `s${sidx}-${qid}`;
  const code = editors[ekey].getValue();
  const t0 = performance.now();
  const { output, error } = await runPython(code);
  const ms = (performance.now() - t0).toFixed(0);
  const panel = document.getElementById(`out-${ekey}`);
  const text  = document.getElementById(`out-text-${ekey}`);
  panel.classList.add('visible');
  document.getElementById(`out-time-${ekey}`).textContent = `${ms}ms`;
  if (error) { text.className = 'output-text error'; text.textContent = error; }
  else       { text.className = 'output-text';       text.textContent = output || '(no output)'; }
}

// ── Check ────────────────────────────────────────────────────────────────────
async function checkCode(sidx, qid) {
  if (!pyodide) return alert('Python is still loading — please wait.');
  const ekey = `s${sidx}-${qid}`;
  const code = editors[ekey].getValue();
  const { output, error } = await runPython(code);
  const panel = document.getElementById(`out-${ekey}`);
  const text  = document.getElementById(`out-text-${ekey}`);
  panel.classList.add('visible');
  if (error) { text.className = 'output-text error'; text.textContent = error; }
  else       { text.className = 'output-text';       text.textContent = output || '(no output)'; }
  if (error) { showResult(ekey, false, null, 'Fix the error above first, then check again.'); return; }
  const lines = output.trimEnd().split('\n');
  const q = SESSIONS[sidx].questions.find(q => String(q.id) === String(qid));
  const result = q.check(lines);
  document.getElementById(`dot-${ekey}`).className = 'status-dot ' + (result.pass ? 'pass' : 'fail');
  if (result.pass) passed[sidx].add(String(qid));
  else             passed[sidx].delete(String(qid));
  updateProgress(sidx);
  showResult(ekey, result.pass, result.diffs, result.msg);
}

// ── Reset ────────────────────────────────────────────────────────────────────
function resetCode(sidx, qid) {
  const ekey = `s${sidx}-${qid}`;
  const q = SESSIONS[sidx].questions.find(q => String(q.id) === String(qid));
  editors[ekey].setValue(q.starter);
  document.getElementById(`out-${ekey}`).classList.remove('visible');
  document.getElementById(`res-${ekey}`).className = 'result-panel';
  document.getElementById(`dot-${ekey}`).className = 'status-dot';
  passed[sidx].delete(String(qid));
  updateProgress(sidx);
}

// ── Progress ─────────────────────────────────────────────────────────────────
function updateProgress(sidx) {
  const total = SESSIONS[sidx].questions.length;
  const n = passed[sidx].size;
  document.getElementById('progressFill').style.width = `${(n / total) * 100}%`;
  document.getElementById('progressLabel').textContent = `${n} / ${total}`;
  const btn = document.getElementById(`tab-btn-${sidx}`);
  if (n === total && total > 0) btn.classList.add('done');
  else btn.classList.remove('done');
}

// ── Result panel ──────────────────────────────────────────────────────────────
function showResult(ekey, pass, diffs, msg) {
  const panel = document.getElementById(`res-${ekey}`);
  panel.className = 'result-panel visible ' + (pass ? 'pass' : 'fail');
  if (pass) {
    panel.innerHTML = `<div class="result-title">✅ Passed!</div><div>${msg || 'Your output matches perfectly.'}</div>`;
  } else {
    let html = `<div class="result-title">❌ Not quite — check the diff below</div>`;
    if (msg) html += `<div>${msg}</div>`;
    if (diffs) diffs.forEach(d => {
      html += `<div class="diff-row">
        Got:      <span class="diff-got">${escHtml(d.got)}</span><br>
        Expected: <span class="diff-expected">${escHtml(d.exp)}</span>
      </div>`;
    });
    panel.innerHTML = html;
  }
}

// ── Init ─────────────────────────────────────────────────────────────────────
buildUI();
initEditors(0);

(async () => {
  pyodide = await loadPyodide();
  const ov = document.getElementById('loading');
  ov.style.opacity = '0';
  setTimeout(() => ov.style.display = 'none', 500);
})();
</script>
